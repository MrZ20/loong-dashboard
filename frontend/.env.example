# OpenAI-compatible AI provider. Runtime secrets are configured in Sites.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_MODE=responses
AI_MODEL=gpt-5-mini

# Optional GitHub token for higher rate limits and private repository access.
GITHUB_TOKEN=

# Local Wrangler development only.
ALLOW_DEV_AUTH=true
LOCAL_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
SESSION_SECRET=replace-with-a-long-random-local-secret
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
SEED_DEMO_DATA=false
