{
  "name": "loong-dashboard-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-octicons.mjs && vite",
    "dev:service": "npm run build && node scripts/dev-service.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml",
    "runner": "node local-runner/index.mjs",
    "build": "node scripts/generate-octicons.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "node scripts/generate-octicons.mjs && vue-tsc --noEmit",
    "preview": "vite preview",
    "test:sites": "npm run build --silent && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@primer/octicons": "^19.24.1",
    "dompurify": "^3.2.6",
    "marked": "^16.1.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "esbuild": "^0.25.8",
    "typescript": "^5.8.0",
    "vite": "^6.4.2",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.26.1"
  }
}
